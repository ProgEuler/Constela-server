	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "1. Sign Up",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"alex@example.com\",\n    \"password\": \"UserPassword123!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/auth/signup/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"signup",
								""
							]
						},
						"description": "Creates an inactive account and sends a 4-digit OTP code to the registered email address."
					},
					"response": []
				},
				{
					"name": "2. Verify OTP",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"alex@example.com\",\n    \"otp\": \"7473\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/auth/verify-otp/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"verify-otp",
								""
							]
						},
						"description": "Submits the 4-digit code. On success, activates the account and returns the JWT Bearer Token."
					},
					"response": []
				},
				{
					"name": "3. Log In",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if(jsonData.access) {",
									"    pm.globals.set(\"access_token\", jsonData.access);",
									"    pm.globals.set(\"refresh_token\", jsonData.refresh);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"alex@example.com\",\n    \"password\": \"UserPassword123!\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"auth",
								"login",
								""
							]
						},
						"description": "Subsequent login session. Automatically extracts and sets the global 'access_token' variable upon success."
					},
					"response": []
				}
			]
		},
